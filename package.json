{
  "name": "dsh-filepath-drop",
  "version": "1.2.0",
  "description": "将 DSH 自带的「拖入文件即上传附件」替换为「在会话输入框光标处插入该文件的本地路径文本」，文件不上传、只引用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "attachment",
    "drag-drop",
    "file-path"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check lib/client.js && node --check lib/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TAOQILA/dsh-filepath-drop.git"
  },
  "homepage": "https://github.com/TAOQILA/dsh-filepath-drop#readme",
  "bugs": {
    "url": "https://github.com/TAOQILA/dsh-filepath-drop/issues"
  }
}
